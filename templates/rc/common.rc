set editor = "$RC_EDITOR"

set header_cache = "\$HOME/.cache/neomutt/\$from/headers"
set message_cachedir = "\$HOME/.cache/neomutt/\$from/bodies"
set certificate_file = "\$HOME/.cache/neomutt/\$from/certificates"

set pager_index_lines = 10
set pager_context = 3         # show 3 lines of context
set pager_stop                # stop at end of message
set menu_scroll               # scroll menu
set tilde                     # use ~ to pad mutt
set move=no                   # don't move messages when marking as read
set mail_check = 30           # check for new mail every 30 seconds
set imap_keepalive = 900      # 15 minutes
set sleep_time = 0            # don't sleep when idle
set wait_key = no             # mutt won't ask "press key to continue"
set envelope_from             # which from?
set edit_headers              # show headers when composing
set fcc_attach                # save attachments with the body
set forward_format = "%s"     # format of subject when forwarding
set forward_decode            # decode when forwarding
set forward_quote             # include message in forwards
set mime_forward              # forward attachments as part of body
set attribution = "(%d) %n:"  # format of quoting header
set reply_to                  # reply to Reply to: field
set reverse_name              # reply as whomever it was to
set include                   # include message in replies
set text_flowed=yes           # correct indentation for plain text
unset sig_dashes              # no dashes before sig
unset markers

set charset = "utf-8"
set uncollapse_jump
set sort_re
set sort = reverse-threads
set sort_aux = last-date-received
set reply_regexp = "^(([Rr][Ee]?(\\[[0-9]+\\])?: *)?(\\[[^]]+\\] *)?)*"
set quote_regexp = "^( {0,4}[>|:#%]| {0,4}[a-z0-9]+[>|]+)+"
set send_charset = "utf-8:iso-8859-1:us-ascii" # send in utf-8

set sidebar_visible
set sidebar_short_path
set sidebar_folder_indent
set sidebar_format = "%B %* [%?N?%N / ?%S]"
set mail_check_stats
bind index,pager \\CJ sidebar-next
bind index,pager \\CK sidebar-prev
bind index,pager \\CE sidebar-open
bind index,pager B sidebar-toggle-visible

macro index A \\
    "<tag-pattern>~N<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" \\
    "mark all new as read"

bind index j next-entry
bind index k previous-entry
bind pager j next-line
bind pager k previous-line

bind attach,index,pager \\CD next-page
bind attach,index,pager \\CU previous-page
bind pager g top
bind pager G bottom
bind attach,index g first-entry
bind attach,index G last-entry

set mailcap_path = "\$HOME/.config/neomutt_setup/\$from/mailcap"
bind attach <return> view-mailcap
macro attach s '<save-entry> <bol>~/Documents/attachments/<eol>' 'save attachment'
auto_view text/html

color status green default

#gpg
set pgp_default_key = "$RC_PGPKEY"  # $RC_FROM
set crypt_use_gpgme = yes
set crypt_autosign = no
set crypt_replysign = yes
set crypt_replyencrypt = yes
set crypt_replysignencrypted = yes
set crypt_verify_sig = yes
set crypt_opportunistic_encrypt = no
auto_view application/pgp-encrypted
